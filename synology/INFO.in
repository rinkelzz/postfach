package="postfach"
version="@VERSION@"
os_min_ver="7.0-40000"
displayname="Postfach"
description="E-Mail-Programm für IMAP-Konten auf der NAS: mehrere Benutzer mit eigenen Konten, gemeinsamer Posteingang, Lesen, Suchen, Antworten und Weiterleiten mit Anhängen, sichere Anzeige von HTML-Mails (externe Bilder blockiert), verschlüsselt gespeicherte Passwörter, Single Sign-on für DSM-Benutzer und nächtliche Datensicherung."
description_ger="E-Mail-Programm für IMAP-Konten auf der NAS: mehrere Benutzer mit eigenen Konten, gemeinsamer Posteingang, Lesen, Suchen, Antworten und Weiterleiten mit Anhängen, sichere Anzeige von HTML-Mails (externe Bilder blockiert), verschlüsselt gespeicherte Passwörter, Single Sign-on für DSM-Benutzer und nächtliche Datensicherung."
description_enu="Webmail client for IMAP accounts on your NAS – multiple users, unified inbox, reply/forward with attachments, safe HTML display, DSM single sign-on, nightly backups (German UI)."
arch="noarch"
maintainer="rinkelzz"
maintainer_url="https://github.com/rinkelzz/postfach"
distributor="rinkelzz"
distributor_url="https://github.com/rinkelzz/postfach"
support_url="https://github.com/rinkelzz/postfach/issues"
thirdparty="yes"
beta="no"
startable="yes"
ctl_stop="yes"
silent_upgrade="yes"
dsmuidir="ui"
dsmappname="SYNO.SDS.Postfach.Application"
