
# --- postinst: Konfiguration aus dem Assistenten schreiben, Datenbank + Admin anlegen

mkdir -p "${PKGVAR}"

PORT="${wizard_port:-8810}"
case "$PORT" in ''|*[!0-9]*) PORT=8810 ;; esac
# Ports, die DSM selbst braucht, nicht zulassen
case "$PORT" in 80|443|5000|5001|5005|5006|6690|9900|9901) PORT=8810 ;; esac

set -- $(find_python)
PY="$1"; TAG="$2"
# Gewünschter Port schon belegt (z. B. von einer anderen App)? Dann den nächsten freien nehmen.
if [ -n "$PY" ] && port_in_use "$PY" "$PORT"; then
    START=8810; [ "$PORT" = 8810 ] && START=8811
    NEW=$(free_port "$PY" "$START")
    if [ -n "$NEW" ]; then
        log "Port ${PORT} ist schon belegt – nehme Port ${NEW}"
        PORT="$NEW"
    fi
fi

if [ ! -f "${CONFIG}" ]; then
    {
        echo "# Postfach – Einstellungen. Nach Änderungen das Paket neu starten."
        echo "# Den Port besser in der App ändern (Verwaltung → System) – dann startet sie selbst neu."
        echo "PF_PORT=${PORT}"
        echo "PF_PUBLIC_URL=\"\""
        echo "PF_ROOT_PATH=\"\""
        echo "PF_COOKIE_SECURE=0"
        echo "PF_TIMEZONE=\"Europe/Berlin\""
    } > "${CONFIG}"
fi

if [ -n "$PY" ]; then
    # Admin-Passwort wird nur hier verwendet und nirgends gespeichert
    PF_DATA_DIR="${PKGVAR}" PF_ADMIN_PASSWORD="${wizard_admin_password:-}" \
    PF_COMPANY="${wizard_company:-}" \
    PYTHONPATH="$(lib_path "$PY" "$TAG")" PYTHONDONTWRITEBYTECODE=1 \
        "$PY" -c "from app.db import init_db; init_db()" >> "${LOGFILE}" 2>&1
    log "Installation abgeschlossen (${PY}, Port ${PORT})"
fi
exit 0
